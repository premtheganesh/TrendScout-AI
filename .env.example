# Copy to .env and fill in. Never commit .env.

# https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=trendscout_ai

# Where build_indexes.py writes FAISS + BM25 (relative to the repo root).
# The frozen evaluation corpus uses MONGODB_DB=trendscout_eval INDEX_DIR=data/eval_index
INDEX_DIR=data

# API server
CORS_ORIGINS=*
ADMIN_TOKEN=

# Local: neo4j://127.0.0.1:7687   Aura: neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# Classic PAT, no scopes needed
GITHUB_TOKEN=ghp_your_token_here

LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
